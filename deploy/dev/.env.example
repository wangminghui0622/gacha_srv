# dev 环境变量模板：复制为 .env 后按需修改
#   cp deploy/dev/.env.example deploy/dev/.env

# ── 镜像 ──
# 镜像标签（dev/test/staging/product 各自对应同名 tag）
IMAGE_TAG=dev
# 镜像仓库前缀（本地无仓库留空；远程仓库填如 registry.example.com/luckybox/）
REGISTRY=

# ── 基础设施（dev/test 内置 MySQL/Redis/Etcd）──
# MySQL root 密码（迁移 job 用）与业务库密码（服务 DataSource 用）
MYSQL_ROOT_PASSWORD=we7root
MYSQL_PASSWORD=we7root
MYSQL_PORT=3306

# Redis 密码
REDIS_PASSWORD=we7redis
REDIS_PORT=6379

# Etcd 客户端端口
ETCD_PORT=2379

# ── 容器内服务发现地址（dev 内置基础设施，用默认值即可，无需覆盖）──
# MYSQL_HOST=mysql
# REDIS_HOST=redis
# ETCD_ENDPOINTS=etcd:2379
