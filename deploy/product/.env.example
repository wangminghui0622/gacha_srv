# product 环境变量模板：外部托管基础设施，填真实地址/密码
#   cp deploy/product/.env.example deploy/product/.env

# ── 镜像（生产用不可变 tag，如 git sha，不用 :product 这种可变 tag）──
IMAGE_TAG=latest
REGISTRY=registry.example.com/luckybox/

# ── 外部基础设施地址（product 不内置，指向生产 MySQL/Redis/Etcd）──
MYSQL_HOST=prod-mysql.example.com
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PASSWORD=change_me

REDIS_HOST=prod-redis.example.com
REDIS_PASSWORD=change_me

ETCD_ENDPOINTS=prod-etcd-1.example.com:2379,prod-etcd-2.example.com:2379,prod-etcd-3.example.com:2379
