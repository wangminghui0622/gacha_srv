# staging 环境变量模板：外部托管基础设施，填真实地址/密码
#   cp deploy/staging/.env.example deploy/staging/.env

# ── 镜像 ──
IMAGE_TAG=staging
REGISTRY=

# ── 外部基础设施地址（staging 不内置，指向外部 MySQL/Redis/Etcd）──
MYSQL_HOST=your-mysql.example.com
MYSQL_ROOT_PASSWORD=change_me      # 迁移 job 用（root）
MYSQL_PASSWORD=change_me           # 业务库密码

REDIS_HOST=your-redis.example.com
REDIS_PASSWORD=change_me

ETCD_ENDPOINTS=your-etcd.example.com:2379
