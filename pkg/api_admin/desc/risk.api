// ════════════════════════════════════════════════════════════════
// 风控案件控制台（ConsoleRiskHTTPService 契约照抄 server_v2）：
// 列表（游标）→ 认领（无 body，Idempotency-Key=operationId）→ 解决（body）。
// 请求/响应线格式（protojson camelCase）由各 handler 用 restx.ParseProto/
// WriteProto 直接收发 base proto 消息，此处类型仅驱动 goctl 路由表生成。
// ════════════════════════════════════════════════════════════════

type (
	ListRiskCasesReq {
		ActorId                   int64  `form:"actorId,optional"`
		Status                    int64  `form:"status,optional"`
		PageSize                  int64  `form:"pageSize,optional"`
		BeforeCreatedAtUnixMillis int64  `form:"beforeCreatedAtUnixMillis,optional"`
		BeforeCaseId              string `form:"beforeCaseId,optional"`
	}
	// 认领：无 body（server_v2 同款）；caseId 取路径，operationId 取 Idempotency-Key 头
	ClaimRiskCaseReq {
		CaseId string `path:"caseId"`
	}
	// 解决：body 取 status/resolutionCode；caseId 取路径，operationId 取 Idempotency-Key 头
	ResolveRiskCaseReq {
		CaseId         string `path:"caseId"`
		Status         int64  `json:"status,optional"`
		ResolutionCode string `json:"resolutionCode,optional"`
	}
	// 响应由 handler 用 base.RiskCaseTransition/RiskCaseSummary 输出（protojson），
	// 此处类型仅占位驱动路由生成
	RiskResp {
		CaseId string `json:"caseId"`
	}
	ListRiskCasesResp {
		Cases []string `json:"cases"`
	}
)

// 全部需会话 + 权限点（resource: risk.case）
@server (
	prefix:     /console/v2/api
	group:      risk
	middleware: RequestId
	middleware: ConsoleAuth
	middleware: ConsoleAuthorize
	tags:       "风控"
)
service admin-api {
	@doc "风控案件列表（risk.case:list；游标分页）"
	@handler ListRiskCases
	get /risk/cases (ListRiskCasesReq) returns (ListRiskCasesResp)

	@doc "认领风控案件（risk.case:claim；Idempotency-Key 幂等）"
	@handler ClaimRiskCase
	post /risk/cases/:caseId/claim (ClaimRiskCaseReq) returns (RiskResp)

	@doc "解决风控案件（risk.case:resolve；Idempotency-Key 幂等）"
	@handler ResolveRiskCase
	post /risk/cases/:caseId/resolve (ResolveRiskCaseReq) returns (RiskResp)
}
